@{
    ViewData["Title"] = "Home Page";
}


<div class="text-center my-5">
    <h1 class="display-4 mb-4">Welcome to the Hospital Management System</h1>
    <p class="lead text-muted mb-5">Browse medical departments or view the list of doctors using the options below:</p>

    <div class="d-flex justify-content-center gap-3">

        <a asp-controller="Doctor" asp-action="AllDoctors"
           class="btn btn-outline-primary btn-lg px-4 py-3 shadow-sm rounded-3">
            Doctors
        </a>

        <a asp-controller="Department" asp-action="AllDepartments"
           class="btn btn-outline-primary btn-lg px-4 py-3 shadow-sm rounded-3">
            Departments
        </a>

    </div>
</div>