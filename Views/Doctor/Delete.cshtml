@model Day2.Task1.Models.Doctor
@{
    ViewData["Title"] = "Remove Doctor";
}

<div class="row justify-content-center mt-5">
    <div class="col-12 col-md-7 col-lg-5">
        <div class="card border-0 shadow text-center p-4">

            <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle bg-danger-subtle text-danger" style="width:72px;height:72px;">
                <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5m.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2" />
                </svg>
            </div>

            <h4 class="fw-bold mb-1">Remove Dr. @Model.Name?</h4>
            <p class="text-muted mb-4">This will permanently remove the doctor's record. It can't be undone.</p>

            <ul class="list-group list-group-flush text-start mb-4">
                <li class="list-group-item d-flex justify-content-between">
                    <span class="text-muted">Department</span>
                    <span class="fw-semibold">@(Model.Department?.Name ?? "No Department")</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span class="text-muted">Email</span>
                    <span class="fw-semibold">@Model.Email</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span class="text-muted">Phone</span>
                    <span class="fw-semibold">@Model.Phone</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span class="text-muted">Age</span>
                    <span class="fw-semibold">@Model.Age</span>
                </li>
            </ul>

            <form method="post" asp-action="DeleteConfirmed" asp-route-id="@Model.DoctorId" class="d-grid gap-2">
                <button type="submit" class="btn btn-danger rounded-pill">Yes, remove this doctor</button>
                <a asp-action="AllDoctors" class="btn btn-link text-secondary text-decoration-none">Keep doctor &amp; go back</a>
            </form>
        </div>
    </div>
</div>
