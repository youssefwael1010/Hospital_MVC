@model Day2.Task1.Models.Department

@{
    ViewData["Title"] = "Add Department";
}

<div class="page-heading">
    <div>
        <h1>Add a department</h1>
    </div>
</div>

<div class="form-card narrow-form">
    <form asp-action="Add" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label">Department name</label>
            <input asp-for="Name" class="form-control" placeholder="e.g. Cardiology" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="mb-2">
            <label asp-for="Description" class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control" rows="5" placeholder="Briefly describe the department..."></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="form-actions d-flex gap-2 mt-4">
            <a asp-action="AllDepartments" class="btn btn-light border">Cancel</a>
            <button type="submit" class="btn btn-primary px-4">Add Department</button>
        </div>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
