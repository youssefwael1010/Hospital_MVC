@model IEnumerable<Day2.Task1.Models.Department>

<div class="container mt-4">
    <div class="row mb-3 align-items-center">
        <div class="col">
            <h2>Department List</h2>
            <a asp-action="Add" class="btn btn-primary"> Add Department</a>
        </div>
    </div>
</div>

<table class="table table-striped table-bordered shadow-sm">
    <thead class="table-primary">
        <tr>
            <th>ID</th>
            <th>Department Name</th>
            <th>Description</th>
            <th class="text-center" style="width: 220px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if(Model != null && Model.Any())
        {

            @foreach (var dept in Model)
            {
                <tr>
                    <td class ="align-middle">@dept.DepartmentId</td>
                    <td class="align-middle fw-bold">@dept.Name</td>
                    <td class="align-middle">@dept.Description</td>
                    <td class="text-center align-middle">
                        <a asp-action="Details" asp-route-id="@dept.DepartmentId" class="btn btn-primary btn-sm">Details</a>
                        <a asp-action="Edit" asp-route-id="@dept.DepartmentId" class="btn btn-sm btn-info">Edit</a>
                        <form asp-controller="Department" asp-action="Delete" asp-route-id="@dept.DepartmentId" method="post" class="d-inline" onsubmit="return confirm('Delete this department?');">
                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    </td>
                </tr>
            }

        }
        else
        {
            <tr>
                <td colspan="4" class="text-center text-muted py-3">No departments available.</td>
            </tr>
        }

        

    </tbody>
</table>

<div class="mb-4">
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary rounded-pill px-3 shadow-sm">
        <i class="fas fa-arrow-left me-2"></i> Back to Home
    </a>
</div>

